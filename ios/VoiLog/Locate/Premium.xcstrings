    },
    "%@/年で自動的に課金されます。更新日の24時間前までにAppleのサブスクリプション設定からいつでもキャンセルできます。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم تحصيل %@/سنة تلقائيًا. يمكنك الإلغاء في أي وقت من إعدادات الاشتراكات في Apple قبل 24 ساعة على الأقل من تاريخ التجديد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/বছর হারে স্বয়ংক্রিয়ভাবে চার্জ করা হবে। রিনিউ হওয়ার তারিখের অন্তত ২৪ ঘণ্টা আগে Apple-এর সাবস্ক্রিপশন সেটিংস থেকে যেকোনো সময় বাতিল করতে পারবেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es cobrarà automàticament %@/any. Pots cancel·lar-ho en qualsevol moment des de la configuració de subscripcions d'Apple fins a 24 hores abans de la data de renovació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Účtuje se automaticky %@/rok. Předplatné můžete kdykoli zrušit v nastavení předplatných Apple nejpozději 24 hodin před datem obnovení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du trækkes automatisk %@/år. Du kan til enhver tid annullere i Apples abonnementsindstillinger senest 24 timer før fornyelsesdatoen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es werden automatisch %@/Jahr abgerechnet. Sie können jederzeit über Apples Abonnementeinstellungen kündigen, mindestens 24 Stunden vor dem Verlängerungsdatum."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρεώνεται αυτόματα %@/έτος. Μπορείτε να ακυρώσετε οποτεδήποτε από τις ρυθμίσεις συνδρομών της Apple έως 24 ώρες πριν από την ανανέωση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You will be charged %@/year automatically. You can cancel anytime from Apple's subscription settings at least 24 hours before the renewal date."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se te cobrará %@/año automáticamente. Puedes cancelar en cualquier momento desde la configuración de suscripciones de Apple al menos 24 horas antes de la fecha de renovación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veloitetaan automaattisesti %@/vuosi. Voit perua milloin tahansa Applen tilausasetuksista viimeistään 24 tuntia ennen uusimispäivää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous serez facturé %@/an automatiquement. Vous pouvez annuler à tout moment depuis les paramètres d'abonnement d'Apple au moins 24 heures avant la date de renouvellement."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/વર્ષના દરે આપમેળે ચાર્જ થશે. રિન્યૂઅલની તારીખના ઓછામાં ઓછા 24 કલાક પહેલાં Appleના સબ્સ્ક્રિપ્શન સેટિંગ્સમાંથી ગમે ત્યારે રદ કરી શકો છો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החיוב של %@ לשנה יתבצע אוטומטית. אפשר לבטל בכל עת בהגדרות המינויים של Apple, עד 24 שעות לפני מועד החידוש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपसे %@/वर्ष स्वचालित रूप से शुल्क लिया जाएगा। आप नवीनीकरण तिथि से कम से कम 24 घंटे पहले Apple सदस्यता सेटिंग में कभी भी रद्द कर सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatski se naplaćuje %@ godišnje. Pretplatu možete otkazati u bilo kojem trenutku u Appleovim postavkama pretplate, najkasnije 24 sata prije datuma obnove."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az előfizetés automatikusan megújul, díja %@/év. A megújítás előtt legalább 24 órával bármikor lemondhatod az Apple előfizetési beállításaiban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda akan dikenakan biaya %@/tahun secara otomatis. Anda dapat membatalkan kapan saja di pengaturan langganan Apple paling lambat 24 jam sebelum tanggal perpanjangan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verranno addebitati %@/anno automaticamente. Puoi annullare in qualsiasi momento dalle impostazioni di abbonamento di Apple almeno 24 ore prima della data di rinnovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/年で自動的に課金されます。更新日の24時間前までにAppleのサブスクリプション設定からいつでもキャンセルできます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ವರ್ಷಕ್ಕೆ %@ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಶುಲ್ಕ ವಿಧಿಸಲಾಗುತ್ತದೆ. ನವೀಕರಣ ದಿನಾಂಕಕ್ಕೆ ಕನಿಷ್ಠ 24 ಗಂಟೆ ಮುಂಚೆ Apple ಸಬ್‌ಸ್ಕ್ರಿಪ್ಷನ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳಿಂದ ಯಾವಾಗ ಬೇಕಾದರೂ ರದ್ದುಮಾಡಬಹುದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/년이 자동으로 청구됩니다. 갱신일 최소 24시간 전까지 Apple 구독 설정에서 언제든지 취소할 수 있습니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പ്രതിവർഷം %@ സ്വയമേവ ഈടാക്കും. പുതുക്കൽ തീയതിക്ക് 24 മണിക്കൂർ മുമ്പ് വരെ Apple സബ്സ്ക്രിപ്ഷൻ ക്രമീകരണങ്ങളിൽ എപ്പോൾ വേണമെങ്കിലും റദ്ദാക്കാം."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/वर्ष या दराने आपोआप शुल्क आकारले जाईल. नूतनीकरणाच्या तारखेच्या किमान २४ तास आधी Apple च्या सबस्क्रिप्शन सेटिंग्जमधून कधीही रद्द करू शकता."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/tahun dicaj secara automatik. Anda boleh membatalkan pada bila-bila masa melalui seting langganan Apple sekurang-kurangnya 24 jam sebelum tarikh pembaharuan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du belastes automatisk %@/år. Du kan når som helst si opp i Apples abonnementsinnstillinger senest 24 timer før fornyelsesdatoen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je betaalt automatisch %@/jaar. Je kunt op elk moment opzeggen via de abonnementsinstellingen van Apple, uiterlijk 24 uur voor de verlengingsdatum."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/ବର୍ଷ ହାରରେ ସ୍ୱୟଂଚାଳିତ ଭାବେ ଚାର୍ଜ ହେବ। ନବୀକରଣ ତାରିଖର ଅତି କମରେ 24 ଘଣ୍ଟା ପୂର୍ବରୁ Appleର ସବସ୍କ୍ରିପସନ୍ ସେଟିଂସରୁ ଯେକୌଣସି ସମୟରେ ବାତିଲ କରିପାରିବେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/ਸਾਲ ਦੀ ਦਰ ਨਾਲ ਆਪਣੇ-ਆਪ ਚਾਰਜ ਹੋਵੇਗਾ। ਰਿਨਿਊ ਹੋਣ ਦੀ ਮਿਤੀ ਤੋਂ ਘੱਟੋ-ਘੱਟ 24 ਘੰਟੇ ਪਹਿਲਾਂ Apple ਦੀਆਂ ਸਬਸਕ੍ਰਿਪਸ਼ਨ ਸੈਟਿੰਗਾਂ ਤੋਂ ਕਦੇ ਵੀ ਰੱਦ ਕਰ ਸਕਦੇ ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Będziesz automatycznie obciążany kwotą %@/rok. Możesz anulować w dowolnym momencie w ustawieniach subskrypcji Apple, co najmniej 24 godziny przed datą odnowienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cobrança automática de %@/ano. Cancele quando quiser nos ajustes de assinaturas da Apple, até 24 horas antes da renovação."
