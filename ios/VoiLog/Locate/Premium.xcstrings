        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 ਦਿਨਾਂ ਦੇ ਮੁਫ਼ਤ ਟ੍ਰਾਇਲ ਤੋਂ ਬਾਅਦ ਆਪਣੇ-ਆਪ %@/ਮਹੀਨਾ ਚਾਰਜ ਹੋਵੇਗਾ। ਰਿਨਿਊ ਹੋਣ ਦੀ ਮਿਤੀ ਤੋਂ ਘੱਟੋ-ਘੱਟ 24 ਘੰਟੇ ਪਹਿਲਾਂ Apple ਦੀਆਂ ਸਬਸਕ੍ਰਿਪਸ਼ਨ ਸੈਟਿੰਗਾਂ ਤੋਂ ਕਦੇ ਵੀ ਰੱਦ ਕਰ ਸਕਦੇ ਹੋ।"
          }
        },
        "pl" : {
