        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serão cobrados %@/ano automaticamente. Pode cancelar a qualquer momento nas definições de subscrição da Apple, pelo menos 24 horas antes da data de renovação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se percepe automat %@/an. Puteți anula oricând din configurările abonamentelor Apple, cu cel puțin 24 de ore înainte de data reînnoirii."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С вас будет автоматически списываться %@/год. Вы можете отменить подписку в любое время в настройках подписок Apple не менее чем за 24 часа до даты продления."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suma %@/rok sa bude účtovať automaticky. Predplatné môžete kedykoľvek zrušiť v nastaveniach predplatného Apple najneskôr 24 hodín pred dátumom obnovenia."
