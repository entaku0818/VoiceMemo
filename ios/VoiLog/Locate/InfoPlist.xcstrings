    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستخدم لتسجيل صوتك والأصوات الأخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার কণ্ঠ ও অন্যান্য অডিও রেকর্ড করতে ব্যবহার করা হয়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es fa servir per gravar la teva veu i altres sons."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slouží k nahrávání vašeho hlasu a dalších zvuků."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruges til at optage din stemme og anden lyd."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird verwendet, um Ihre Stimme und andere Töne aufzunehmen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιείται για την ηχογράφηση της φωνής σας και άλλων ήχων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to record your voice and other audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para grabar tu voz y otros sonidos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofonia käytetään äänesi ja muun äänen tallentamiseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé pour enregistrer votre voix et d’autres sons."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારો અવાજ અને અન્ય ઑડિયો રેકોર્ડ કરવા માટે વપરાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המיקרופון משמש להקלטת הקול שלך ושמע נוסף."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी आवाज़ और अन्य ऑडियो रिकॉर्ड करने के लिए उपयोग किया जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristi se za snimanje vašeg glasa i drugog zvuka."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hangod és más hangok rögzítéséhez szükséges."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digunakan untuk merekam suara Anda dan audio lainnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serve per registrare la tua voce e altri suoni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの声を音声にして記録します"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮ್ಮ ಧ್ವನಿ ಮತ್ತು ಇತರ ಆಡಿಯೋವನ್ನು ರೆಕಾರ್ಡ್ ಮಾಡಲು ಬಳಸಲಾಗುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자의 목소리와 기타 오디오를 녹음하는 데 사용됩니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങളുടെ ശബ്ദവും മറ്റ് ഓഡിയോയും റെക്കോർഡ് ചെയ്യാൻ ഉപയോഗിക്കുന്നു."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमचा आवाज आणि इतर ऑडिओ रेकॉर्ड करण्यासाठी वापरले जाते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digunakan untuk merakam suara anda dan audio lain."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brukes til å ta opp stemmen din og annen lyd."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt gebruikt om je stem en andere geluiden op te nemen."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣଙ୍କ ସ୍ୱର ଓ ଅନ୍ୟ ଅଡିଓ ରେକର୍ଡ କରିବା ପାଇଁ ବ୍ୟବହୃତ ହୁଏ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਹਾਡੀ ਆਵਾਜ਼ ਅਤੇ ਹੋਰ ਆਡੀਓ ਰਿਕਾਰਡ ਕਰਨ ਲਈ ਵਰਤਿਆ ਜਾਂਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Służy do nagrywania Twojego głosu i innych dźwięków."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado para gravar sua voz e outros sons."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilizado para gravar a sua voz e outros sons."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microfonul este folosit pentru a vă înregistra vocea și alte sunete."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется для записи вашего голоса и других звуков."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofón sa používa na nahrávanie vášho hlasu a iného zvuku."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uporablja se za snemanje vašega glasu in drugega zvoka."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Används för att spela in din röst och andra ljud."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் குரலையும் பிற ஒலிகளையும் பதிவுசெய்யப் பயன்படுகிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ గొంతును, ఇతర ఆడియోను రికార్డ్ చేయడానికి ఉపయోగించబడుతుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้เพื่อบันทึกเสียงพูดของคุณและเสียงอื่นๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesinizi ve diğer sesleri kaydetmek için kullanılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовується для запису вашого голосу та інших звуків."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کی آواز اور دیگر آڈیو ریکارڈ کرنے کے لیے استعمال ہوتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng để ghi lại giọng nói của bạn và các âm thanh khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于录制您的声音及其他音频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於錄製您的聲音及其他音訊。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستخدم لاستعادة ذكرياتك من خلال الصور الموجودة في مكتبتك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার লাইব্রেরির ছবি দিয়ে স্মৃতিগুলো ফিরে দেখতে ব্যবহার করা হয়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es fa servir per recordar moments amb les fotos de la teva fototeca."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slouží k připomenutí vzpomínek pomocí fotek z vaší knihovny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruges til at genopleve dine minder med billeder fra dit fotobibliotek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird verwendet, um mit Fotos aus Ihrer Mediathek auf Erinnerungen zurückzublicken."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιείται για να θυμηθείτε στιγμές μέσα από φωτογραφίες της βιβλιοθήκης σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to look back on your memories with photos from your library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para recordar momentos con las fotos de tu fototeca."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuvakirjaston kuvien avulla voit muistella tallentamiasi hetkiä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé pour revivre vos souvenirs grâce aux photos de votre photothèque."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારી લાઇબ્રેરીના ફોટા વડે યાદો ફરી જોવા માટે વપરાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגישה לתמונות משמשת כדי להיזכר ברגעים באמצעות תמונות מהספרייה שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी लाइब्रेरी की फ़ोटो से अपनी यादें फिर से देखने के लिए उपयोग किया जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristi se za prisjećanje uz fotografije iz vaše medijateke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fotókönyvtárad képeivel idézheted fel az emlékeidet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digunakan untuk mengenang momen melalui foto di perpustakaan Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serve per ripercorrere i tuoi ricordi con le foto della tua libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アルバムの写真から振り返ります"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮ್ಮ ಲೈಬ್ರರಿಯ ಫೋಟೋಗಳೊಂದಿಗೆ ನೆನಪುಗಳನ್ನು ಮೆಲುಕು ಹಾಕಲು ಬಳಸಲಾಗುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진 보관함의 사진으로 추억을 돌아보는 데 사용됩니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
