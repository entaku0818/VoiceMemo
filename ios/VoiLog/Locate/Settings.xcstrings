    "いただいたサポートは開発費用として大切に利用させていただきます。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نقدّر دعمك كثيرًا، وسيُستخدم لتغطية تكاليف التطوير."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার সহায়তা আমরা কৃতজ্ঞতার সঙ্গে অ্যাপ ডেভেলপমেন্টের খরচে ব্যবহার করব।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El teu suport es farà servir per cobrir les despeses de desenvolupament. Moltes gràcies!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaší podpory si velmi vážíme a využijeme ji na další vývoj."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din støtte bliver brugt til den videre udvikling af appen. Tusind tak!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Unterstützung wird sehr geschätzt und fließt in die Entwicklung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η υποστήριξή σας θα αξιοποιηθεί για την κάλυψη του κόστους ανάπτυξης. Σας ευχαριστούμε!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your support is greatly appreciated and goes toward development costs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu apoyo nos ayuda mucho y se destinará a los costes de desarrollo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiitämme tuestasi – se käytetään sovelluksen kehittämiseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre soutien sera grandement apprécié et utilisé pour les coûts de développement."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારા સહયોગની અમે ખૂબ કદર કરીએ છીએ અને તેનો ઉપયોગ ઍપના વિકાસ ખર્ચ માટે કરીશું."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התמיכה שלך תנוצל לטובת המשך הפיתוח. תודה רבה!"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके सहयोग की अत्यधिक सराहना की जाएगी और इसे विकास लागत के रूप में उपयोग किया जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vašu ćemo podršku s velikom zahvalnošću iskoristiti za troškove razvoja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A támogatásodat köszönettel a fejlesztés költségeire fordítjuk."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dukungan Anda akan sangat dihargai dan digunakan sebagai biaya pengembangan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo sostegno sarà molto apprezzato e utilizzato per i costi di sviluppo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いただいたサポートは開発費用として大切に利用させていただきます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮ್ಮ ಬೆಂಬಲವನ್ನು ಅಭಿವೃದ್ಧಿ ವೆಚ್ಚಕ್ಕಾಗಿ ಬಳಸಲಾಗುತ್ತದೆ. ಹೃತ್ಪೂರ್ವಕ ಧನ್ಯವಾದಗಳು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여러분의 지원은 개발 비용으로 소중히 사용됩니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങളുടെ പിന്തുണ ഏറെ വിലമതിക്കപ്പെടും, അത് വികസന ചെലവുകൾക്കായി ഉപയോഗിക്കും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमच्या पाठिंब्याबद्दल आम्ही मनापासून आभारी आहोत; तो ॲपच्या विकास खर्चासाठी वापरला जाईल."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sokongan anda amat dihargai dan akan digunakan untuk kos pembangunan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Støtten din settes stor pris på og går til videreutvikling av appen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We waarderen je steun enorm en gebruiken deze voor de verdere ontwikkeling van de app."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣଙ୍କ ସହଯୋଗ ପାଇଁ ଆମେ କୃତଜ୍ଞ, ଏବଂ ଏହାକୁ ଆପ୍ ବିକାଶ ଖର୍ଚ୍ଚରେ ବ୍ୟବହାର କରିବୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਹਾਡੇ ਸਹਿਯੋਗ ਦੀ ਅਸੀਂ ਬਹੁਤ ਕਦਰ ਕਰਦੇ ਹਾਂ ਅਤੇ ਇਸਨੂੰ ਐਪ ਦੇ ਵਿਕਾਸ ਖ਼ਰਚਿਆਂ ਲਈ ਵਰਤਾਂਗੇ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bardzo dziękujemy za wsparcie — przeznaczymy je na rozwój aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu apoio será usado com carinho para cobrir os custos de desenvolvimento."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu apoio é muito apreciado e será utilizado nos custos de desenvolvimento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprijinul dumneavoastră va fi folosit cu recunoștință pentru costurile de dezvoltare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спасибо за поддержку — она пойдёт на развитие приложения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vašu podporu si veľmi vážime a použijeme ju na ďalší vývoj."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vašo podporo bomo hvaležno porabili za stroške razvoja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi uppskattar ditt stöd mycket – det går till den fortsatta utvecklingen av appen."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் ஆதரவு மிகவும் பாராட்டப்படும், அது மேம்பாட்டுச் செலவுகளுக்குப் பயன்படுத்தப்படும்."
          }
        },
        "te" : {
          "stringUnit" : {
