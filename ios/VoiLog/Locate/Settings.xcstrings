        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie Unterstützung leisten möchten, tätigen Sie bitte einen Kauf auf dem nächsten Bildschirm. Die Unterstützung wird für die Entwicklungskosten verwendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν θέλετε να μας υποστηρίξετε, κάντε μια αγορά στην επόμενη οθόνη. Τα έσοδα θα καλύψουν το κόστος ανάπτυξης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you'd like to support us, please make a purchase on the next screen. It goes toward development costs."
