        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se revisó este dispositivo, pero no faltaba ninguna grabación en la lista. Inicia sesión en iCloud para comprobar también las grabaciones sincronizadas allí."
          }
        },
        "fr" : {
          "stringUnit" : {
