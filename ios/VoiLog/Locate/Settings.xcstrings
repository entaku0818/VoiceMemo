    "iCloudから%d件の録音を一覧に戻しました。タイトル・文字起こしも一緒に戻っています。" : {
      "comment" : "Alert body when recordings were restored from iCloud only.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت استعادة %d تسجيل من iCloud، ومعها العناوين والنصوص المفرَّغة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d Aufnahme(n) aus iCloud wiederhergestellt. Titel und Transkriptionen sind ebenfalls zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restored %d recording(s) from iCloud. Their titles and transcriptions came back too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se restauraron %d grabación(es) desde iCloud. También se recuperaron sus títulos y transcripciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d enregistrement(s) restauré(s) depuis iCloud. Les titres et les transcriptions sont également revenus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud से %d रिकॉर्डिंग वापस सूची में जोड़ी गईं. शीर्षक और ट्रांसक्रिप्शन भी वापस आ गए हैं."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memulihkan %d rekaman dari iCloud. Judul dan transkripsinya ikut kembali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripristinate %d registrazioni da iCloud. Anche titoli e trascrizioni sono tornati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudから%d件の録音を一覧に戻しました。タイトル・文字起こしも一緒に戻っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud에서 %d개의 녹음을 목록에 되돌렸습니다. 제목과 문자 변환도 함께 복구되었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d opname(s) uit iCloud hersteld. Titels en transcripties zijn ook terug."
          }
        },
        "pl" : {
