        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudから%d件の録音を一覧に戻しました。タイトル・文字起こしも一緒に戻っています。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud ನಿಂದ %d ರೆಕಾರ್ಡಿಂಗ್(ಗಳನ್ನು) ಮರುಸ್ಥಾಪಿಸಲಾಗಿದೆ. ಅವುಗಳ ಶೀರ್ಷಿಕೆ ಮತ್ತು ಪ್ರತಿಲೇಖನಗಳೂ ಮರಳಿ ಬಂದಿವೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud에서 %d개의 녹음을 목록에 되돌렸습니다. 제목과 문자 변환도 함께 복구되었습니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud-ൽ നിന്ന് %d റെക്കോർഡിംഗ്(കൾ) പുനഃസ്ഥാപിച്ചു. അവയുടെ ശീർഷകങ്ങളും ട്രാൻസ്ക്രിപ്ഷനുകളും തിരികെ ലഭിച്ചു."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud मधून %d रेकॉर्डिंग सूचीत परत आणली. त्यांची शीर्षके आणि ट्रान्सक्रिप्शनही परत आली आहेत."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d rakaman dipulihkan daripada iCloud. Tajuk dan transkripsinya turut dipulihkan."
          }
        },
        "nb" : {
          "stringUnit" : {
