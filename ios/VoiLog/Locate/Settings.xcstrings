          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت استعادة %d تسجيل من هذا الجهاز. أُنشئت العناوين من تاريخ التسجيل، فغيّرها عند الحاجة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d Aufnahme(n) von diesem Gerät wiederhergestellt. Die Titel stammen aus dem Aufnahmedatum – benennen Sie sie bei Bedarf um."
          }
