    "端末内から%1$d件、iCloudから%2$d件の録音を一覧に戻しました。タイトルは録音日時から付け直しています。" : {
      "comment" : "Alert body when recordings were restored from both the device and iCloud.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت استعادة %1$d تسجيل من هذا الجهاز و%2$d من iCloud. أُعيد إنشاء العناوين من تاريخ التسجيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$d Aufnahme(n) von diesem Gerät und %2$d aus iCloud wiederhergestellt. Die Titel wurden aus dem Aufnahmedatum neu erzeugt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restored %1$d recording(s) from this device and %2$d from iCloud. Titles were regenerated from the recording date."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se restauraron %1$d grabación(es) de este dispositivo y %2$d de iCloud. Los títulos se generaron de nuevo a partir de la fecha de grabación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$d enregistrement(s) restauré(s) depuis cet appareil et %2$d depuis iCloud. Les titres ont été recréés à partir de la date d'enregistrement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिवाइस से %1$d और iCloud से %2$d रिकॉर्डिंग वापस सूची में जोड़ी गईं. शीर्षक रिकॉर्डिंग की तारीख़ से दोबारा बनाए गए हैं."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memulihkan %1$d rekaman dari perangkat ini dan %2$d dari iCloud. Judul dibuat ulang dari tanggal perekaman."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripristinate %1$d registrazioni da questo dispositivo e %2$d da iCloud. I titoli sono stati rigenerati dalla data di registrazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "端末内から%1$d件、iCloudから%2$d件の録音を一覧に戻しました。タイトルは録音日時から付け直しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서 %1$d개, iCloud에서 %2$d개의 녹음을 목록에 되돌렸습니다. 제목은 녹음 날짜로 다시 만들었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$d opname(s) van dit apparaat en %2$d uit iCloud hersteld. Titels zijn opnieuw gemaakt op basis van de opnamedatum."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przywrócono %1$d nagrań z tego urządzenia i %2$d z iCloud. Tytuły zostały utworzone ponownie na podstawie daty nagrania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$d gravação(ões) restaurada(s) deste dispositivo e %2$d do iCloud. Os títulos foram gerados novamente a partir da data da gravação."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$d gravação(ões) restaurada(s) deste dispositivo e %2$d do iCloud. Os títulos foram gerados novamente a partir da data da gravação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восстановлено записей: %1$d с устройства и %2$d из iCloud. Названия созданы заново по дате записи."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Återställde %1$d inspelning(ar) från den här enheten och %2$d från iCloud. Titlarna har skapats på nytt utifrån inspelningsdatumet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กู้คืน %1$d รายการจากเครื่องนี้ และ %2$d รายการจาก iCloud แล้ว ชื่อถูกสร้างใหม่จากวันที่บันทึก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu cihazdan %1$d, iCloud'dan %2$d kayıt geri yüklendi. Başlıklar kayıt tarihinden yeniden oluşturuldu."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã khôi phục %1$d bản ghi từ thiết bị này và %2$d từ iCloud. Tiêu đề được tạo lại từ ngày ghi âm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已从本机恢复 %1$d 个录音，从 iCloud 恢复 %2$d 个。标题已根据录音日期重新生成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已從本機復原 %1$d 個錄音，從 iCloud 復原 %2$d 個。標題已依照錄音日期重新產生。"
          }
        }
      }
    },
    "端末内から%d件の録音を一覧に戻しました。タイトルは録音日時から付け直しているため、必要に応じて変更してください。" : {
      "comment" : "Alert body when recordings were restored from the device only.",
      "localizations" : {
