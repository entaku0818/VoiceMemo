    "端末内から%1$d件、iCloudから%2$d件の録音を一覧に戻しました。タイトルは録音日時から付け直しています。" : {
      "comment" : "Alert body when recordings were restored from both the device and iCloud.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت استعادة %1$d تسجيل من هذا الجهاز و%2$d من iCloud. أُعيد إنشاء العناوين من تاريخ التسجيل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই ডিভাইস থেকে %1$dটি এবং iCloud থেকে %2$dটি রেকর্ডিং তালিকায় ফিরিয়ে আনা হয়েছে। রেকর্ডিংয়ের তারিখ থেকে নতুন শিরোনাম দেওয়া হয়েছে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gravacions recuperades: %1$d del dispositiu i %2$d de l'iCloud. Els títols s'han tornat a generar a partir de la data de gravació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obnoveny nahrávky ze zařízení (počet: %1$d) a z iCloudu (počet: %2$d). Názvy byly znovu vytvořeny podle data nahrání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optagelser gendannet – fra enheden: %1$d, fra iCloud: %2$d. Titlerne er lavet ud fra optagelsesdatoen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$d Aufnahme(n) von diesem Gerät und %2$d aus iCloud wiederhergestellt. Die Titel wurden aus dem Aufnahmedatum neu erzeugt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επαναφέρθηκαν ηχογραφήσεις στη λίστα — από τη συσκευή: %1$d, από το iCloud: %2$d. Οι τίτλοι δημιουργήθηκαν ξανά από την ημερομηνία ηχογράφησης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restored %1$d recording(s) from this device and %2$d from iCloud. Titles were regenerated from the recording date."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se restauraron %1$d grabación(es) de este dispositivo y %2$d de iCloud. Los títulos se generaron de nuevo a partir de la fecha de grabación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palautettiin luetteloon äänitteitä – tältä laitteelta: %1$d, iCloudista: %2$d. Otsikot luotiin uudelleen äänityspäivän perusteella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$d enregistrement(s) restauré(s) depuis cet appareil et %2$d depuis iCloud. Les titres ont été recréés à partir de la date d'enregistrement."
          }
        },
        "gu" : {
