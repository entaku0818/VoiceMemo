    "iCloudから%d件の録音を一覧に戻しました。タイトル・文字起こしも一緒に戻っています。" : {
      "comment" : "Alert body when recordings were restored from iCloud only.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت استعادة %d تسجيل من iCloud، ومعها العناوين والنصوص المفرَّغة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud থেকে %dটি রেকর্ডিং তালিকায় ফিরিয়ে আনা হয়েছে। শিরোনাম ও ট্রান্সক্রিপশনও ফিরে এসেছে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gravacions recuperades de l'iCloud: %d. També s'han recuperat els títols i les transcripcions."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z iCloudu obnoveny nahrávky (počet: %d). Vrátily se i jejich názvy a přepisy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optagelser gendannet fra iCloud: %d. Titler og transskriptioner er også kommet tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d Aufnahme(n) aus iCloud wiederhergestellt. Titel und Transkriptionen sind ebenfalls zurück."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επαναφέρθηκαν ηχογραφήσεις από το iCloud: %d. Επανήλθαν επίσης οι τίτλοι και οι απομαγνητοφωνήσεις τους."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restored %d recording(s) from iCloud. Their titles and transcriptions came back too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se restauraron %d grabación(es) desde iCloud. También se recuperaron sus títulos y transcripciones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palautettiin iCloudista luetteloon äänitteitä: %d. Myös niiden otsikot ja litteroinnit palautettiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d enregistrement(s) restauré(s) depuis iCloud. Les titres et les transcriptions sont également revenus."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudમાંથી %d રેકોર્ડિંગ સૂચિમાં પાછાં લાવવામાં આવ્યાં. તેમનાં શીર્ષક અને ટ્રાન્સક્રિપ્શન પણ પાછાં આવ્યાં છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקלטות ששוחזרו לרשימה מ-iCloud: %d. גם הכותרות והתמלולים שוחזרו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud से %d रिकॉर्डिंग वापस सूची में जोड़ी गईं। शीर्षक और ट्रांसक्रिप्शन भी वापस आ गए हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
