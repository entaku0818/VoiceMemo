        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "જો તમે સહયોગ આપવા માંગતા હો, તો કૃપા કરીને આગલી સ્ક્રીન પર ખરીદી કરો. આ સહયોગનો ઉપયોગ વિકાસ ખર્ચ માટે થશે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם ברצונך לתמוך, אפשר לבצע רכישה במסך הבא. התמיכה תשמש לכיסוי עלויות הפיתוח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यदि आप सहयोग प्रदान करना चाहते हैं, तो कृपया अगली स्क्रीन पर खरीदारी करें। सहयोग विकास लागत के लिए उपयोग किया जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako želite podržati razvoj, obavite kupnju na sljedećem zaslonu. Podrška će se koristiti za troškove razvoja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha támogatni szeretnél, a következő képernyőn vásárolhatsz. Az összeget a fejlesztés költségeire fordítjuk."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika Anda ingin memberikan dukungan, silakan lakukan pembelian di layar berikutnya. Dukungan akan digunakan untuk biaya pengembangan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se desideri fornire supporto, effettua un acquisto nella prossima schermata. Il supporto verrà utilizzato per i costi di sviluppo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ご支援いただける場合は次の画面で購入お願いいたします。開発費用に利用させていただきます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಬೆಂಬಲ ನೀಡಲು ಬಯಸಿದರೆ, ಮುಂದಿನ ಪರದೆಯಲ್ಲಿ ಖರೀದಿಸಿ. ಬೆಂಬಲವನ್ನು ಅಭಿವೃದ್ಧಿ ವೆಚ್ಚಕ್ಕಾಗಿ ಬಳಸಲಾಗುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지원을 원하시면 다음 화면에서 구매해 주세요. 지원금은 개발 비용으로 사용됩니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പിന്തുണ നൽകാൻ ആഗ്രഹിക്കുന്നുവെങ്കിൽ, അടുത്ത സ്ക്രീനിൽ വാങ്ങുക. ആ പിന്തുണ വികസന ചെലവുകൾക്കായി ഉപയോഗിക്കും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्हाला पाठिंबा द्यायचा असल्यास, कृपया पुढील स्क्रीनवर खरेदी करा. हा पाठिंबा विकास खर्चासाठी वापरला जाईल."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika anda ingin memberikan sokongan, sila buat pembelian pada skrin seterusnya. Sokongan tersebut akan digunakan untuk kos pembangunan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du vil støtte oss, kan du gjøre et kjøp på neste skjerm. Støtten går til videreutvikling av appen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wil je ons steunen? Doe dan een aankoop op het volgende scherm. Je steun wordt gebruikt voor de ontwikkeling van de app."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଯଦି ଆପଣ ସହଯୋଗ କରିବାକୁ ଚାହାଁନ୍ତି, ଦୟାକରି ପରବର୍ତ୍ତୀ ସ୍କ୍ରିନରେ କ୍ରୟ କରନ୍ତୁ। ଏହି ସହଯୋଗ ବିକାଶ ଖର୍ଚ୍ଚରେ ବ୍ୟବହୃତ ହେବ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਜੇ ਤੁਸੀਂ ਸਹਿਯੋਗ ਦੇਣਾ ਚਾਹੁੰਦੇ ਹੋ, ਤਾਂ ਕਿਰਪਾ ਕਰਕੇ ਅਗਲੀ ਸਕ੍ਰੀਨ ’ਤੇ ਖ਼ਰੀਦ ਕਰੋ। ਇਹ ਸਹਿਯੋਗ ਵਿਕਾਸ ਖ਼ਰਚਿਆਂ ਲਈ ਵਰਤਿਆ ਜਾਵੇਗਾ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli chcesz udzielić wsparcia, dokonaj zakupu na następnym ekranie. Wsparcie zostanie wykorzystane na koszty rozwoju."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se quiser apoiar, faça uma compra na próxima tela. O valor será usado nos custos de desenvolvimento."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se quiser apoiar, faça uma compra no ecrã seguinte. O apoio será utilizado nos custos de desenvolvimento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă doriți să ne sprijiniți, efectuați o achiziție pe ecranul următor. Sprijinul va fi folosit pentru costurile de dezvoltare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вы хотите оказать поддержку, пожалуйста, совершите покупку на следующем экране. Поддержка будет использована для разработки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak nás chcete podporiť, dokončite nákup na ďalšej obrazovke. Podporu použijeme na ďalší vývoj."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če želite podpreti razvoj, opravite nakup na naslednjem zaslonu. Podporo bomo porabili za stroške razvoja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du vill stödja oss kan du göra ett köp på nästa skärm. Stödet går till utvecklingen av appen."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஆதரவு தர விரும்பினால், அடுத்த திரையில் வாங்கவும். அந்த ஆதரவு மேம்பாட்டுச் செலவுகளுக்குப் பயன்படுத்தப்படும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీరు సపోర్ట్ చేయాలనుకుంటే, తదుపరి స్క్రీన్‌లో కొనుగోలు చేయండి. ఆ సపోర్ట్‌ను డెవలప్‌మెంట్ ఖర్చులకు ఉపయోగిస్తాము."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากคุณต้องการให้การสนับสนุน โปรดทำการซื้อในหน้าจอถัดไป การสนับสนุนจะนำไปใช้เป็นค่าใช้จ่ายในการพัฒนา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Destek sağlamak istiyorsanız, lütfen bir sonraki ekranda bir satın alma işlemi yapın. Bu destek, geliştirme maliyetleri için kullanılacaktır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо бажаєте підтримати, здійсніть покупку на наступному екрані. Кошти буде використано на розвиток програми."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر آپ سپورٹ کرنا چاہتے ہیں تو براہ کرم اگلی اسکرین پر خریداری کریں۔ یہ سپورٹ ڈیولپمنٹ کے اخراجات میں استعمال ہوگی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bạn muốn hỗ trợ, vui lòng thực hiện mua hàng trên màn hình tiếp theo. Sự hỗ trợ sẽ được sử dụng cho chi phí phát triển."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
