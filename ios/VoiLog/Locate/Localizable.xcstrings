          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקלטת פגישות, הרצאות ורעיונות\nבהקשה אחת.\nכדאי לנסות עכשיו!"
          }
        },
        "hi" : {
          "stringUnit" : {
