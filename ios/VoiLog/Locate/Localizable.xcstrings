    "会議・講義・アイデアを\nワンタップで録音保存。\n実際に試してみましょう！" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل الاجتماعات والمحاضرات والأفكار\nبنقرة واحدة.\nجرّبه الآن!"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মিটিং, লেকচার আর আইডিয়া\nএক ট্যাপেই রেকর্ড করুন।\nএখনই চেষ্টা করে দেখুন!"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grava reunions, classes i idees\namb un sol toc.\nProva-ho ara!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahrávejte schůzky, přednášky i nápady\njediným klepnutím.\nVyzkoušejte to!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optag møder, forelæsninger og idéer\nmed et enkelt tryk.\nPrøv det nu!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meetings, Vorlesungen und Ideen\nmit nur einem Tippen aufnehmen.\nProbier es gleich aus!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ηχογραφήστε συσκέψεις, διαλέξεις και ιδέες\nμε ένα μόνο άγγιγμα.\nΔοκιμάστε το!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Record meetings, lectures, and ideas\nwith a single tap.\nGive it a try!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graba reuniones, clases e ideas\ncon un solo toque.\n¡Pruébalo ahora!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Äänitä kokoukset, luennot ja ideat\nyhdellä napautuksella.\nKokeile heti!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez réunions, cours et idées\nd'un simple toucher.\nEssayez dès maintenant !"
