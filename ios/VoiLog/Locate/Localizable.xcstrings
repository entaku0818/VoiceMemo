    "チュートリアルをスキップしますか？\n後で設定画面から再度確認できます。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد تخطي البرنامج التعليمي؟\nيمكنك عرضه مرة أخرى لاحقاً في الإعدادات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "টিউটোরিয়াল এড়িয়ে যাবেন?\nপরে সেটিংস থেকে আবার দেখতে পারবেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vols ometre el tutorial?\nEl pots tornar a veure més tard a Configuració."
          }
        },
        "cs" : {
          "stringUnit" : {
