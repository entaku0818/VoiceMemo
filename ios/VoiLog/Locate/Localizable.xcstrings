        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಮೀಟಿಂಗ್, ಉಪನ್ಯಾಸ ಮತ್ತು ಐಡಿಯಾಗಳನ್ನು\nಒಂದೇ ಟ್ಯಾಪ್‌ನಲ್ಲಿ ರೆಕಾರ್ಡ್ ಮಾಡಿ.\nಈಗಲೇ ಪ್ರಯತ್ನಿಸಿ!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "회의, 강의, 아이디어를\n탭 한 번으로 녹음하세요.\n지금 바로 해 보세요!"
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "മീറ്റിംഗുകളും ക്ലാസുകളും ആശയങ്ങളും\nഒറ്റ ടാപ്പിൽ റെക്കോർഡ് ചെയ്യൂ.\nഇപ്പോൾ തന്നെ പരീക്ഷിക്കൂ!"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
