        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ηχογραφήσεις μπορεί να περιέχουν προσωπικές πληροφορίες, όπως τις φωνές των ομιλητών και το περιεχόμενο των συνομιλιών."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recordings may contain personal information, such as the voices of people speaking and what they say."
