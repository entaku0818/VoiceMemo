          "stringUnit" : {
            "state" : "translated",
            "value" : "ਰਿਕਾਰਡਿੰਗਾਂ ਵਿੱਚ ਨਿੱਜੀ ਜਾਣਕਾਰੀ ਹੋ ਸਕਦੀ ਹੈ, ਜਿਵੇਂ ਕਿ ਬੋਲਣ ਵਾਲਿਆਂ ਦੀ ਆਵਾਜ਼ ਅਤੇ ਗੱਲਬਾਤ ਦੀ ਸਮੱਗਰੀ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagrania mogą zawierać dane osobowe, takie jak głosy mówiących osób i treść rozmów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As gravações podem conter informações pessoais, como a voz das pessoas que falam e o conteúdo das conversas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As gravações podem conter informações pessoais, como a voz das pessoas que falam e o conteúdo das conversas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Înregistrările pot conține informații personale, cum ar fi vocile persoanelor care vorbesc și conținutul conversațiilor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записи могут содержать персональные данные, например голоса говорящих и содержание разговоров."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahrávky môžu obsahovať osobné údaje, napríklad hlasy hovoriacich a obsah rozhovorov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posnetki lahko vsebujejo osebne podatke, na primer glasove govorcev in vsebino pogovorov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspelningar kan innehålla personuppgifter, till exempel rösterna hos dem som talar och innehållet i samtal."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பதிவுகளில் பேசுபவர்களின் குரல், உரையாடலின் உள்ளடக்கம் போன்ற தனிப்பட்ட தகவல்கள் இருக்கலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "రికార్డింగ్‌లలో మాట్లాడేవారి గొంతు, సంభాషణ విషయం వంటి వ్యక్తిగత సమాచారం ఉండవచ్చు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การบันทึกเสียงอาจมีข้อมูลส่วนบุคคล เช่น เสียงของผู้พูดและเนื้อหาของการสนทนา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayıtlar, konuşan kişilerin sesleri ve konuşmaların içeriği gibi kişisel bilgiler içerebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записи можуть містити персональні дані, як-от голоси мовців і зміст розмов."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ریکارڈنگز میں ذاتی معلومات شامل ہو سکتی ہیں، جیسے بولنے والوں کی آوازیں اور گفتگو کا مواد۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản ghi âm có thể chứa thông tin cá nhân, chẳng hạn như giọng nói của người nói và nội dung cuộc trò chuyện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录音中可能包含个人信息，例如说话者的声音和对话内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "錄音中可能包含個人資訊，例如說話者的聲音和對話內容。"
          }
        }
      }
    },
