    "通常2〜5分かかります。このまましばらくお待ちください。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستغرق هذا عادةً 2–5 دقائق. يرجى الانتظار."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সাধারণত ২–৫ মিনিট লাগে। একটু অপেক্ষা করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalment triga entre 2 i 5 minuts. Espera un moment."
          }
