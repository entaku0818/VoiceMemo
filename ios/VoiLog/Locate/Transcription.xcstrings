    "通常2〜5分かかります。このまましばらくお待ちください。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستغرق هذا عادةً 2–5 دقائق. يرجى الانتظار."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সাধারণত ২–৫ মিনিট লাগে। একটু অপেক্ষা করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalment triga entre 2 i 5 minuts. Espera un moment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obvykle to trvá 2–5 minut. Chvíli strpení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det tager normalt 2-5 minutter. Vent venligst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies dauert normalerweise 2–5 Minuten. Bitte warten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνήθως διαρκεί 2–5 λεπτά. Περιμένετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This usually takes 2–5 minutes. Please wait."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto suele tardar 2–5 minutos. Por favor, espera."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä kestää yleensä 2–5 minuuttia. Odota hetki."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela prend généralement 2–5 minutes. Veuillez patienter."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સામાન્ય રીતે 2–5 મિનિટ લાગે છે. કૃપા કરીને રાહ જુઓ."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התהליך נמשך בדרך כלל 2–5 דקות. נא להמתין."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसमें आमतौर पर 2–5 मिनट लगते हैं। कृपया प्रतीक्षा करें।"
          }
