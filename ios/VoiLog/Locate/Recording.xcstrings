        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கூட்டங்கள், கலந்துரையாடல்களுக்கு ஏற்றது. பல குரல்களைத் தெளிவாகப் பதிவுசெய்யச் சமநிலையான அமைப்புகள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీటింగ్‌లు, చర్చలకు అనువైనది. అనేక గొంతులను స్పష్టంగా రికార్డ్ చేయడానికి సమతుల్య సెట్టింగ్‌లు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เหมาะสำหรับการประชุมและการอภิปราย การตั้งค่าที่สมดุลเพื่อบันทึกหลายเสียงได้อย่างชัดเจน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toplantı ve görüşmeler için ideal. Birden fazla kişinin sesini net yakalayan dengeli ayarlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ідеально для нарад і зустрічей. Збалансовані параметри для чіткого запису кількох голосів."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "میٹنگز اور گفتگو کے لیے بہترین۔ کئی آوازوں کو واضح طور پر ریکارڈ کرنے کے لیے متوازن سیٹنگز۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lý tưởng cho cuộc họp và thảo luận. Thiết lập cân bằng để thu rõ nhiều giọng nói."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最适合会议和讨论。平衡设置，清晰收录多人声音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最適合會議和討論。平衡設定，清楚收錄多人聲音。"
          }
        }
      }
    },
