    "会議や打ち合わせに最適。複数人の声を聞き取りやすいバランス設定です。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مثالي للاجتماعات والمناقشات. إعدادات متوازنة لالتقاط أصوات متعددة بوضوح."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মিটিং ও আলোচনার জন্য আদর্শ। একাধিক জনের কণ্ঠ স্পষ্টভাবে ধরার জন্য ভারসাম্যপূর্ণ সেটিং।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ideal per a reunions i debats. Configuració equilibrada per captar bé diverses veus."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ideální pro porady a schůzky. Vyvážené nastavení pro srozumitelné zachycení více hlasů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ideel til møder og samtaler. Afbalancerede indstillinger, så flere stemmer høres tydeligt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ideal für Meetings und Besprechungen. Ausgewogene Einstellungen, um mehrere Stimmen klar aufzunehmen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ιδανικό για συσκέψεις και συζητήσεις. Ισορροπημένες ρυθμίσεις για καθαρή λήψη πολλών φωνών."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ideal for meetings and discussions. Balanced settings for capturing multiple voices clearly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ideal para reuniones y debates. Ajustes equilibrados para captar con claridad varias voces."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sopii kokouksiin ja palavereihin. Tasapainoiset asetukset useiden puhujien selkeään tallentamiseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idéal pour les réunions et les discussions. Réglages équilibrés pour capter clairement plusieurs voix."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "મીટિંગ અને ચર્ચા માટે આદર્શ. એકથી વધુ લોકોના અવાજ સ્પષ્ટ રીતે પકડવા માટે સંતુલિત સેટિંગ."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אידיאלי לפגישות ולדיונים. הגדרות מאוזנות לקליטה ברורה של כמה דוברים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बैठकों और चर्चाओं के लिए आदर्श। कई आवाज़ों को स्पष्ट रूप से कैप्चर करने के लिए संतुलित सेटिंग।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idealno za sastanke i razgovore. Uravnotežene postavke za jasno snimanje više glasova."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megbeszélésekhez és értekezletekhez ideális. Kiegyensúlyozott beállítás, hogy több hang is jól érthető legyen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ideal untuk rapat dan diskusi. Pengaturan seimbang untuk merekam beberapa suara dengan jelas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ideale per riunioni e incontri. Impostazioni bilanciate per catturare chiaramente più voci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会議や打ち合わせに最適。複数人の声を聞き取りやすいバランス設定です。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸಭೆ ಮತ್ತು ಚರ್ಚೆಗಳಿಗೆ ಸೂಕ್ತ. ಹಲವು ಧ್ವನಿಗಳನ್ನು ಸ್ಪಷ್ಟವಾಗಿ ದಾಖಲಿಸುವ ಸಮತೋಲಿತ ಸೆಟ್ಟಿಂಗ್‌ಗಳು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "회의 및 미팅에 최적. 여러 사람의 목소리를 명확하게 포착하는 균형 설정입니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "മീറ്റിംഗുകൾക്കും ചർച്ചകൾക്കും അനുയോജ്യം. ഒന്നിലധികം ശബ്ദങ്ങൾ വ്യക്തമായി പകർത്താൻ സന്തുലിത ക്രമീകരണങ്ങൾ."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मीटिंग आणि चर्चांसाठी आदर्श. अनेक लोकांचे आवाज स्पष्टपणे टिपण्यासाठी संतुलित सेटिंग."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesuai untuk mesyuarat dan perbincangan. Seting seimbang untuk merakam beberapa suara dengan jelas."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ideelt for møter og diskusjoner. Balanserte innstillinger som fanger opp flere stemmer tydelig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ideaal voor vergaderingen en discussies. Gebalanceerde instellingen voor het helder opnemen van meerdere stemmen."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ମିଟିଂ ଓ ଆଲୋଚନା ପାଇଁ ଆଦର୍ଶ। ଏକାଧିକ ଲୋକଙ୍କ ସ୍ୱର ସ୍ପଷ୍ଟ ଭାବେ ଧରିବା ପାଇଁ ସନ୍ତୁଳିତ ସେଟିଂ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਮੀਟਿੰਗਾਂ ਅਤੇ ਚਰਚਾਵਾਂ ਲਈ ਆਦਰਸ਼। ਕਈ ਲੋਕਾਂ ਦੀਆਂ ਆਵਾਜ਼ਾਂ ਸਾਫ਼ ਰਿਕਾਰਡ ਕਰਨ ਲਈ ਸੰਤੁਲਿਤ ਸੈਟਿੰਗ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idealny do spotkań i dyskusji. Wyważone ustawienia do wyraźnego nagrywania wielu głosów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ideal para reuniões e conversas. Ajuste equilibrado para captar bem várias vozes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ideal para reuniões e debates. Definições equilibradas para captar várias vozes com clareza."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ideal pentru ședințe și discuții. Configurare echilibrată pentru captarea clară a mai multor voci."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Идеально для встреч и обсуждений. Сбалансированные настройки для чёткой записи нескольких голосов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ideálne na porady a stretnutia. Vyvážené nastavenie pre zrozumiteľné zachytenie viacerých hlasov."
          }
        },
        "sl" : {
          "stringUnit" : {
